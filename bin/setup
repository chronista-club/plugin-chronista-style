#!/bin/bash
# Chronista Style — 開発環境セットアップ (macOS)
# brew ベースで chronista-style に必要な CLI ツールをインストールする
# Windows の場合は bin/setup-windows を使用（Git Bash + winget）
set -euo pipefail

echo "🎨 Chronista Style Setup"
echo "========================"
echo ""

# OS 判定 — macOS 以外は適切な script に誘導
case "$(uname -s)" in
  Darwin*) ;;
  MSYS*|MINGW*|CYGWIN*)
    echo "ℹ Windows (Git Bash) を検出 → bin/setup-windows に切替"
    exec "$(dirname "$0")/setup-windows" "$@"
    ;;
  Linux*)
    echo "⚠ Linux は未対応（Linuxbrew で部分的に動く可能性あり、 自己責任で続行）"
    ;;
  *)
    echo "❌ 未知の OS: $(uname -s)"
    exit 1
    ;;
esac

# brew 確認
if ! command -v brew &>/dev/null; then
  echo "❌ Homebrew が見つかりません"
  echo "   https://brew.sh/ からインストールしてください"
  exit 1
fi

# --- Rust 製 高速 CLI ツール ---
RUST_CLI=(
  # コア（既存コマンド代替）
  lsd        # ls 代替
  fd         # find 代替
  ripgrep    # grep 代替 (rg)
  bat        # cat 代替
  dust       # du 代替
  git-delta  # diff 代替 (delta)
  sd         # sed 代替
  xh         # curl 代替
  procs      # ps 代替
  # データ処理
  jless      # JSON 閲覧
  jaq        # jq 代替（5-10倍速、YAML/TOML 対応）
  # 開発支援
  tokei      # コード統計
  hyperfine  # ベンチマーク
  bacon      # Rust バックグラウンドチェッカー
  cargo-nextest  # 次世代 Rust テストランナー
  # Git
  git-cliff  # CHANGELOG 自動生成
  gitu       # Magit 風 Git TUI
  # ターミナル UX
  starship   # 高速シェルプロンプト
  zoxide     # 学習型ディレクトリジャンプ
  yazi       # ファイルマネージャ
  grex       # 正規表現生成
)

# --- 開発インフラ ---
DEV_INFRA=(
  gh                # GitHub CLI
  mise              # バージョン管理（言語ランタイムの SSOT）
  tmux              # セッション管理（並列開発）
  jq                # JSON 処理
  atuin             # shell history sync（セッション横断検索）
  ruby              # Ruby ランタイム（Homebrew / rake / 既存スクリプト）
  oven-sh/bun/bun   # bun（wrangler / TS SDK / Cloudflare Workers の前提）
)

# --- ビルド支援（cross-build-image skill の前提） ---
BUILD_SUPPORT=(
  sccache    # Rust ビルドキャッシュ（多層 cache の核）
  zig        # cargo-zigbuild 用 cross-compile toolchain
)

# --- LSP / 言語サーバ（system-wide latest、project では mise で上書き想定） ---
# 注: tsc / tsserver は bun が同梱、typescript-language-server は BUN_GLOBALS で入る
LSP_TOOLS=(
  rust-analyzer  # Rust LSP（project では rustup component で override 可）
)

# --- bun global packages（npm エコシステムの開発ツール） ---
BUN_GLOBALS=(
  wrangler                    # Cloudflare Workers CLI
  typescript-language-server  # TS LSP 本体（tsc とは別バイナリ）
)

# --- Lint / 品質チェック ---
LINT_TOOLS=(
  actionlint   # GitHub Actions workflow linter
  shellcheck   # シェルスクリプト linter（この setup 自身を含む）
  sem-cli      # Semgrep — AST パターンによるセマンティック静的解析
  swiftformat  # Swift コードフォーマッタ（creo-id / native dev 用）
  swiftlint    # Swift linter（style + 規約チェック）
  xcbeautify   # Xcode build log pretty-printer
)

# --- GUI Apps（brew --cask） ---
CASK_APPS=(
  kitty    # GPU 加速ターミナル
  zed      # 高速エディタ（CRDT 共同編集）
  claude   # Claude Desktop
  gemini   # Gemini Desktop（council skill の第二意見 GUI）
  discord  # コミュニティ / chronista-club
)

# --- Fonts（brew --cask、terminal / エディタ用） ---
CASK_FONTS=(
  font-monaspice-nerd-font          # GitHub Monaspace + Nerd icons（推奨デフォルト）
  font-fira-code-nerd-font          # Fira Code + ligature + Nerd icons
  font-atkinson-hyperlegible-mono   # アクセシビリティ最適化（長時間コーディング向け）
)

# --- AI / セカンドオピニオン CLI（council skill 連動） ---
AI_TOOLS=(
  gemini-cli  # Gemini API CLI — chronista-style:council の第二意見
  codex       # OpenAI Codex CLI — 第三意見（triadic review）
)

# --- サービス系 CLI ---
SERVICES=(
  1password-cli          # op — シークレット管理（anycreative テナント）
  usacloud               # さくらクラウド CLI（fleetstage 等）
  surrealdb/tap/surreal  # SurrealDB CLI
  podman                 # コンテナランタイム（fleetflow と連動、Docker 代替）
  tailscale              # VPN CLI（GUI が必要なら別途 Mac App Store）
  flarectl               # Cloudflare CLI（wrangler と相補、API 直叩き用途）
)

install_packages() {
  local label="$1"
  shift
  local packages=("$@")
  local to_install=()

  for pkg in "${packages[@]}"; do
    # パッケージ名からコマンド名を推定（tap/name の場合は最後の部分）
    local cmd="${pkg##*/}"
    # brew パッケージ名とコマンド名が違うもの
    case "$cmd" in
      ripgrep)       cmd="rg" ;;
      git-delta)     cmd="delta" ;;
      1password-cli) cmd="op" ;;
      surreal)       cmd="surreal" ;;
    esac

    if command -v "$cmd" &>/dev/null || brew list "$pkg" &>/dev/null; then
      echo "  ✓ $pkg"
    else
      to_install+=("$pkg")
    fi
  done

  if [ ${#to_install[@]} -gt 0 ]; then
    echo ""
    echo "  Installing: ${to_install[*]}"
    brew install "${to_install[@]}"
  fi
}

install_casks() {
  local casks=("$@")
  local to_install=()

  for cask in "${casks[@]}"; do
    if brew list --cask "$cask" &>/dev/null; then
      echo "  ✓ $cask"
    else
      to_install+=("$cask")
    fi
  done

  if [ ${#to_install[@]} -gt 0 ]; then
    echo ""
    echo "  Installing (cask): ${to_install[*]}"
    brew install --cask "${to_install[@]}"
  fi
}

install_bun_globals() {
  if ! command -v bun &>/dev/null; then
    echo "  ⚠ bun 未検出 → DEV_INFRA の install を確認してから再実行"
    return
  fi
  for pkg in "$@"; do
    if command -v "$pkg" &>/dev/null; then
      echo "  ✓ $pkg"
    else
      echo "  Installing (bun): $pkg"
      bun add -g "$pkg"
    fi
  done
}

echo "📦 Rust CLI ツール"
install_packages "rust-cli" "${RUST_CLI[@]}"
echo ""

echo "🔧 開発インフラ"
install_packages "dev-infra" "${DEV_INFRA[@]}"
echo ""

echo "🏗  ビルド支援"
install_packages "build" "${BUILD_SUPPORT[@]}"
echo ""

echo "🧠 LSP / 言語サーバ（mise で project 上書き想定）"
install_packages "lsp" "${LSP_TOOLS[@]}"
echo ""

echo "🧪 Lint / 品質チェック"
install_packages "lint" "${LINT_TOOLS[@]}"
echo ""

echo "🤖 AI / セカンドオピニオン"
install_packages "ai" "${AI_TOOLS[@]}"
echo ""

echo "☁️  サービス系 CLI"
install_packages "services" "${SERVICES[@]}"
echo ""

echo "🖥  GUI Apps (cask)"
install_casks "${CASK_APPS[@]}"
echo ""

echo "🔤 Fonts (cask)"
install_casks "${CASK_FONTS[@]}"
echo ""

# --- cargo install 系（Rust toolchain 依存） ---
echo "🦀 cargo install 系"
install_cargo() {
  local cmd="$1"
  local install_arg="$2"
  local label="${3:-$cmd}"
  if command -v "$cmd" &>/dev/null; then
    echo "  ✓ $label"
  else
    if command -v cargo &>/dev/null; then
      echo "  Installing $label..."
      # shellcheck disable=SC2086  # word splitting は意図的（複数引数渡し）
      cargo install $install_arg
    else
      echo "  ⚠ cargo 未検出 → mise で rust toolchain を入れてから再実行"
      echo "    手動: cargo install $install_arg"
    fi
  fi
}
install_cargo "cargo-zigbuild"  "cargo-zigbuild"   "cargo-zigbuild (cross-build-image skill 必須)"

# vantage-point CLI (vp) — ~/repos/vantage-point の clone 前提
VP_CLI_PATH="$HOME/repos/vantage-point/crates/vp-cli"
if command -v vp &>/dev/null; then
  echo "  ✓ vp (vantage-point CLI)"
elif [ -d "$VP_CLI_PATH" ]; then
  if command -v cargo &>/dev/null; then
    echo "  Installing vp from $VP_CLI_PATH..."
    cargo install --path "$VP_CLI_PATH"
  else
    echo "  ⚠ cargo 未検出 → mise で rust toolchain 入れてから再実行"
  fi
else
  echo "  • vp: ~/repos/vantage-point を clone してから再実行"
  echo "    git clone git@github.com:chronista-club/vantage-point.git ~/repos/vantage-point"
fi

# fleetstage CLI (fsctl) — Proprietary repo、~/repos/fleetstage の clone 前提
FLEETSTAGE_CLI_PATH="$HOME/repos/fleetstage/crates/fleetstage-cli"
if command -v fsctl &>/dev/null; then
  echo "  ✓ fsctl (fleetstage CLI)"
elif [ -d "$FLEETSTAGE_CLI_PATH" ]; then
  if command -v cargo &>/dev/null; then
    echo "  Installing fsctl from $FLEETSTAGE_CLI_PATH..."
    cargo install --path "$FLEETSTAGE_CLI_PATH"
  else
    echo "  ⚠ cargo 未検出 → mise で rust toolchain 入れてから再実行"
  fi
else
  echo "  • fsctl: ~/repos/fleetstage を clone してから再実行"
  echo "    git clone git@github.com:chronista-club/fleetstage.git ~/repos/fleetstage"
fi
echo ""

# --- bun global packages（TS LSP / wrangler 等） ---
echo "📦 bun global packages"
install_bun_globals "${BUN_GLOBALS[@]}"
echo ""

# --- mise: 言語ランタイム同期（SSOT = ~/.config/mise/config.toml） ---
echo "🛠  mise install（言語ランタイム同期）"
if command -v mise &>/dev/null; then
  if [ -f "$HOME/.config/mise/config.toml" ]; then
    echo "  Running: mise install（既存バージョンは skip、不足分のみ取得）"
    mise install || echo "  ⚠ mise install で警告あり（個別 plugin の問題は後で確認）"
  else
    echo "  ⚠ ~/.config/mise/config.toml が無い → 初期化してから再実行"
  fi
else
  echo "  ⚠ mise 未検出（DEV_INFRA で入るはず — 上のエラーを確認）"
fi
echo ""

# --- プロジェクト設定ファイル（実体は共有 config store、project 側は symlink で参照） ---
echo "📄 Claude Code 用プロジェクト設定ファイル"
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# 共有 config store: 個人設定を集約した repo の shared/ 等を CHRONISTA_SHARED_CONFIG で指す。
# 例) export CHRONISTA_SHARED_CONFIG="$HOME/repos/<your-config-repo>/shared"
# 未設定なら .mcp.json.example にフォールバック
SHARED_MCP="${CHRONISTA_SHARED_CONFIG:+${CHRONISTA_SHARED_CONFIG}/claude/.mcp.json}"
# dangling symlink（共有先の移動等）は掃除して再リンク
if [ -L "$REPO_ROOT/.mcp.json" ] && [ ! -e "$REPO_ROOT/.mcp.json" ]; then
  rm "$REPO_ROOT/.mcp.json"
fi
if [ -e "$REPO_ROOT/.mcp.json" ]; then
  echo "  ✓ .mcp.json"
elif [ -f "$SHARED_MCP" ]; then
  ln -s "$SHARED_MCP" "$REPO_ROOT/.mcp.json"
  echo "  + .mcp.json → 共有 config store に symlink（実体は store 側の git が保護）"
elif [ -f "$REPO_ROOT/.mcp.json.example" ]; then
  cp "$REPO_ROOT/.mcp.json.example" "$REPO_ROOT/.mcp.json"
  echo "  + .mcp.json を .mcp.json.example から生成"
else
  echo "  • .mcp.json.example なし（skip）"
fi
echo ""

# Codex の MCP は .mcp.json から自動コピーしない。
echo "  • Codex のプラグイン・MCP 接続: docs/guide/01-installation.md を参照"
echo "  • hooks の実行には bash / git / jq / python3 が必要"
echo ""

# --- 認証確認 / 残作業 ---
echo "📋 認証確認 / 残作業"

# gh 認証
if command -v gh &>/dev/null; then
  if gh auth status &>/dev/null; then
    echo "  ✓ gh 認証済み"
  else
    echo "  • gh 未認証: gh auth login"
  fi
fi

# 1Password CLI（anycreative テナント）
if command -v op &>/dev/null; then
  if op account list &>/dev/null && op account list 2>/dev/null | grep -q anycreative; then
    echo "  ✓ op (anycreative テナント設定済み)"
  else
    echo "  • op: anycreative テナントに sign-in 必要"
    echo "    eval \$(op signin --account anycreative.1password.com)"
  fi
fi

# GUI 補助（cask 未登録だが好みで）
echo "  • Tailscale GUI が要る場合: brew install --cask tailscale"
echo ""

echo "✅ セットアップ完了"
