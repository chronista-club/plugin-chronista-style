{
  "description": "chronista-style hooks (Ruby, fail-open but never silent): SessionStart (project context) and Stop (fabrication tripwire — block reporting tool results with no matching tool_result anywhere in this session)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.rb\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"${CLAUDE_PLUGIN_ROOT}/hooks/fabrication_tripwire.rb\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
